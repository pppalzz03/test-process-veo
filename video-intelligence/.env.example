# Copy to .env and CHANGE every CHANGE_ME value. Never commit .env.
POSTGRES_USER=vi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vi
RABBITMQ_USER=vi
RABBITMQ_PASSWORD=CHANGE_ME
# Optional: require X-API-Key on /v1 endpoints
API_KEY=

# Host folder holding videos (mounted at /data/media). Uploads go to <MEDIA_DIR>/uploads
MEDIA_DIR=./data/media
# Host folder with yolo.onnx (+ cached TensorRT engine)
MODELS_DIR=./deepstream/models

# DeepStream image: verify tag + driver compatibility (docs/environment-report.md)
DEEPSTREAM_IMAGE=ghcr.io/nvidia/deepstream:9.2-triton-sbsa-dgx-spark

# Recorded with every job for provenance; change when you change the model
MODEL_VERSION=yolo-CHANGE_ME
# config_infer_primary_yolo.txt (raw head) or config_infer_primary_yolo_e2e.txt (NMS-free)
DS_INFER_CONFIG=/opt/vi/deepstream/configs/config_infer_primary_yolo.txt

# Single GPU shared with vLLM: start at 1, raise ONLY after docs/benchmark-report.md shows headroom
GPU_MAX_CONCURRENT_STREAMS=1
# Do not admit a pipeline when unified-memory MemAvailable (MiB) is below this
GPU_MIN_AVAILABLE_MEM_MB=8192
SEGMENT_SECONDS=300
MIN_CONFIDENCE=0.25
MAX_ATTEMPTS=4
